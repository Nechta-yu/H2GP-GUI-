class H2BatFrame(ctk.CTkFrame): # <--- fix currentDataDisplayFrame


    def __init__(self,parent,app):
        super().__init__(parent, fg_color="#292929")

        self.currentDataDisplayFrame = ctk.CTkFrame(self)
        self.currentDataDisplayFrame.pack(fill="x")
        for i in range(3):
            self.currentDataDisplayFrame.columnconfigure(i,weight=1,uniform="a")
        for i in range(3):
            self.currentDataDisplayFrame.rowconfigure(i,weight=1,uniform="a")
        
        self.graphDisplayFrame = ctk.CTkFrame(self, fg_color="transparent")
        
        self.graphDisplayFrame.pack(fill="x")
        self.graphOptions = ctk.CTkFrame(self.graphDisplayFrame, fg_color="#292929")
        
        self.currentDataDisplay()
        app.after(100, self.updateDataDisplay())

    def currentDataDisplay(self):
        global h2V, h2A, h2T, batV, batA
        
        # FCV BV FCA TA F V
        self.FCVtext = ctk.CTkLabel(self.currentDataDisplayFrame, text=(f"H2FC Voltage: {h2V}"))
        self.FCVtext.grid(column=0, row=0, sticky="")
        self.FCAtext = ctk.CTkLabel(self.currentDataDisplayFrame, text=(f"H2FC Amperage: {h2A}"))
        self.FCAtext.grid(column=0, row=1, sticky="")
        self.FCPtext = ctk.CTkLabel(self.currentDataDisplayFrame, text=(f"H2FC Power: {h2V*h2A}"))
        self.FCPtext.grid(column=0, row=2, sticky="")
        self.BVtext = ctk.CTkLabel(self.currentDataDisplayFrame, text=(f"Battery Voltage: {batV}"))
        self.BVtext.grid(column=1, row=0, sticky="")
        self.BAtext = ctk.CTkLabel(self.currentDataDisplayFrame, text=(f"Battery Amperage: {batA}"))
        self.BAtext.grid(column=1, row=1, sticky="")
        self.BPtext = ctk.CTkLabel(self.currentDataDisplayFrame, text=(f"Battery Power: {h2V*h2A}"))
        self.BPtext.grid(column=1, row=2, sticky="")
        self.TVtext = ctk.CTkLabel(self.currentDataDisplayFrame, text=(f"Total Voltage: {h2V+batV}"))
        self.TVtext.grid(column=2, row=0, sticky="")
        self.TAtext = ctk.CTkLabel(self.currentDataDisplayFrame, text=(f"Total Amperage: {h2A+batA}"))
        self.TAtext.grid(column=2, row=1, sticky="")
        self.TPtext = ctk.CTkLabel(self.currentDataDisplayFrame, text=(f"Total Power: {(h2V+batV)*(h2A+batA)}"))
        self.TPtext.grid(column=2, row=2, sticky="")
    
    def updateDataDisplay(self):
        self.FCVtext.configure(text=(f"H2FC Voltage: {h2V}"))
        self.FCAtext.configure(text=(f"H2FC Amperage: {h2A}"))
        self.FCPtext.configure(text=(f"H2FC Power: {h2V*h2A}"))
        self.BVtext.configure(text=(f"Battery Voltage: {batV}"))
        self.BAtext.configure(text=(f"Battery Amperage: {batA}"))
        self.BPtext.configure(text=(f"Battery Power: {h2V*h2A}"))
        self.TVtext.configure(text=(f"Total Voltage: {h2V+batV}"))
        self.TAtext.configure(text=(f"Total Amperage: {h2A+batA}"))
        self.TPtext.configure(text=(f"Total Power: {(h2V+batV)*(h2A+batA)}"))


