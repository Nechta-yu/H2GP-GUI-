def updateCESPList(type, value):
    global h2V; global h2A; global h2T; global batV; global batA
    if type == "h2V":
        x=0
    elif type == "h2A":
        x=1
    elif type == "h2T":
        x=2
    elif type == "batA":
        x=3
    elif type == "batV":
        x=4

    cespList[x].append(value)

def recvMsg(app):       # Receive data from CESP
    global h2V, h2A, h2T, batV, batA,x 

    try:
        if ser.in_waiting > 0:
            data = ser.readline().decode("ascii", errors="ignore").strip()
            if data:
                dataList = data.split()
                if len(dataList) >= 5:
                    '''h2V = float(dataList[0])
                    h2A = float(dataList[1])
                    h2T = float(dataList[2])
                    batV = float(dataList[3])
                    batA = float(dataList[4])'''
                    print(dataList)
                else:
                    print(f"Invalid data format: {dataList}")
            else:
                print("Empty line received")
    except Exception as e:
        print(f"Error in recvMsg: {e}")
    app.after(100,lambda: recvMsg(app))

def onClose(app):       # Proper cleanup when closing app
    if ser.is_open:
        ser.close()
    app.destroy()


